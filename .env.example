# ============================================================
# FinanzaHoy — Variables de entorno
# ============================================================
# Copia este archivo como .env.local para desarrollo local
# En Vercel: configura estas variables en el dashboard

# PostgreSQL — Neon (https://neon.tech)
# Obtén tu connection string en: https://console.neon.tech
DATABASE_URL="postgresql://user:password@host/finanzahoy?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/finanzahoy?sslmode=require"

# Nextauth (genera con: openssl rand -base64 32)
NEXTAUTH_SECRET="tu-secreto-aqui-generado-con-openssl"
NEXTAUTH_URL="http://localhost:3000"

# ID del negocio demo (se genera en el seed)
DEMO_NEGOCIO_ID="demo-negocio-001"
